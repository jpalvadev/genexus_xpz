#!/usr/bin/env bash
# Frontend gate: typecheck + lint of staged TS/TSX. The repo's legacy lint
# baseline is red, so lint is staged-scoped — the scoping lives in
# scripts/lint-staged-ts.sh (single source of truth; ad-hoc runs call it too).
# The baseline cleanup is its own future task. Skip with `git commit
# --no-verify` only for deliberate escapes.
set -u
root="$(git rev-parse --show-toplevel)"
cd "$root/frontend" || exit 1
npx tsc -b || { echo "pre-commit: tsc -b failed"; exit 1; }
"$root/scripts/lint-staged-ts.sh" || exit 1
